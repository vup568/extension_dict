{
  "name": "@jp-reading-platform/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build && node --experimental-strip-types build-extension.mjs",
    "build:library": "vite build",
    "build:extension": "node --experimental-strip-types build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "benchmark": "node --experimental-strip-types tests/performance/japanese-text-detection-benchmark.ts",
    "unicode:generate": "node --experimental-strip-types unicode/generate-trigger-ranges.ts",
    "unicode:verify": "node --experimental-strip-types unicode/generate-trigger-ranges.ts --check"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
